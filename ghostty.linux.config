# ═══════════════════════════════════════════════════════════════════════════════
# Ghostty — Linux overrides (linked to ~/.config/ghostty/os.conf by an agent following SETUP.md)
# Everything else comes from ghostty.config. Keep this to what Linux needs.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Font ───────────────────────────────────────────────────────────────────────
# Regular face (JetBrains Mono SemiBold) comes from ghostty.config.
# fontconfig names the family "JetBrains Mono" and treats Bold/Italic as styles,
# so the macOS-style "JetBrains Mono Bold" names don't resolve here.
font-family-bold         = ""
font-family-bold         = JetBrains Mono
font-family-italic       = ""
font-family-italic       = JetBrains Mono
font-family-bold-italic  = ""
font-family-bold-italic  = JetBrains Mono

# "Powerline Extra Symbols" isn't a font on Linux; take the glyphs from the Nerd Font.
font-codepoint-map       = U+E0A0-U+E0A3=JetBrainsMono Nerd Font

# macOS uses 16pt; 13 reads better at this display's scaling.
font-size                = 12

# ── Interaction ────────────────────────────────────────────────────────────────
# The macOS value of 3 scrolls far too fast with Linux wheel events.
mouse-scroll-multiplier  = 0.95

# Ghostty binds ctrl+enter to fullscreen on Linux; SUPER+F already does that.
keybind                  = ctrl+enter=unbind

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend            = epoll
