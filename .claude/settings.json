{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "Co-authored-by: Claude <noreply@anthropic.com>"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Skill(research_codebase)",
      "Skill(format-run-tests-and-credo)",
      "WebFetch",
      "WebSearch",
      "mcp__context-mode__*"
    ],
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh repo delete)",
      "Bash(gh api)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push origin --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Bash(*drop*)",
      "Bash(mix ecto.drop*)",
      "Bash(mix ecto.reset*)"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/format-elixir.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/.agents/.claude/hooks/validate-elm.sh\" && bash \"$CLAUDE_PROJECT_DIR/.agents/.claude/hooks/validate-elm.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/plugins/marketplaces/0.9.17/hooks/pretooluse.mjs\"; [ -f \"$f\" ] && node \"$f\" || exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gsd-check-update.js\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ -f \"$h\" ] && bash \"$h\" session || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/opt/homebrew/bin/node\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)dist/index.js\"'"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "frontend-design@claude-plugins-official": true,
    "revdiff@revdiff": true,
    "superpowers@claude-plugins-official": true,
    "token-optimizer@alexgreensh-token-optimizer": true,
    "ponytail@ponytail": true,
    "engram@engram": true
  },
  "extraKnownMarketplaces": {
    "alexgreensh-token-optimizer": {
      "source": {
        "source": "github",
        "repo": "alexgreensh/token-optimizer"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "revdiff": {
      "source": {
        "source": "github",
        "repo": "umputun/revdiff"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "plansDirectory": "./tmp/plans",
  "autoDreamEnabled": true,
  "preferredNotifChannel": "ghostty"
}
