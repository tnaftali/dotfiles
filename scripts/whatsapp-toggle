#!/bin/bash
# Show or hide WhatsApp. Hiding moves it to special:minimized (the Omarchy minimize
# workspace), so it keeps running and the dock still lists it; a dock click restores it too.
# Launches it when it is not running.
class="brave-web.whatsapp.com__-Default"
hide="special:minimized"
win() { hyprctl clients -j | jq -r --arg c "$class" '[.[] | select(.class == $c)][0] | "\(.address) \(.workspace.name)"'; }
dispatch() { hyprctl dispatch "$1" >/dev/null; }

read -r addr ws < <(win)
if [[ $addr == null ]]; then
  omarchy-launch-webapp "https://web.whatsapp.com/"
  exit
fi
if [[ $ws == "$hide" ]]; then
  active=$(hyprctl activeworkspace -j | jq -r .id)
  dispatch "hl.dsp.window.move({ workspace = \"$active\", follow = false, window = \"address:$addr\" })"
  dispatch "hl.dsp.focus({ window = \"address:$addr\" })"
else
  dispatch "hl.dsp.window.move({ workspace = \"$hide\", follow = false, window = \"address:$addr\" })"
fi
